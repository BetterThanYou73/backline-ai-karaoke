# Python
inference/.venv/
__pycache__/
*.py[cod]
inference/output/
inference/.env

# Node / Next.js
node_modules/
app/.next/
app/out/
app/.env
app/.env.local
app/tsconfig.tsbuildinfo

# Regenerated by `next dev` on every run. AGENTS.md is committed because it is
# the tool-neutral one; this is just a pointer at it.
app/CLAUDE.md

# Generated backing tracks and the cache index
cache/
!cache/.gitkeep

# Audio the user supplies. Track metadata is generated, not committed.
app/data/songs/*
!app/data/songs/.gitkeep
app/data/songs.json
app/data/imports/

