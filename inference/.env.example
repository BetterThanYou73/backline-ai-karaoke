# Backline Inference API Server
# Copy to .env and adjust.

# 1 = return synthesized placeholder audio without loading any ML model.
# Lets the whole app run end-to-end before the multi-GB torch/audiocraft install.
STUB_MODE=1

DEVICE=cuda
PORT=8001
HOST=0.0.0.0

# Melody-conditioned generation model.
# facebook/musicgen-melody  -> 1.5B, ~6GB fp16, fits 8GB VRAM.
# facebook/musicgen-melody-large -> 3.3B, needs 12GB+ or 8-bit quantization.
MUSICGEN_MODEL=facebook/musicgen-melody
MODEL_PATH=

# faster-whisper checkpoint: tiny | base | small | medium | large-v3
WHISPER_MODEL=small

# Rendered audio lands here; the App Server copies it into its own cache.
OUTPUT_DIR=./output

# Chunked generation. MusicGen emits at most 30s per call, so a full song is
# rendered as successive melody-conditioned windows and crossfaded together.
CHUNK_SECONDS=30
CROSSFADE_SECONDS=1.0

# Hard cap on rendered length. 0 = render the whole song.
# On an 8GB laptop 4070 a 30s chunk takes roughly 40-70s, so a 3-minute song
# is a ~5 minute render. Cap it while iterating.
MAX_RENDER_SECONDS=90

# Free the resident model after this many idle seconds. 0 = keep loaded.
# Non-zero matters on 8GB: the music model and Whisper cannot coexist.
IDLE_UNLOAD_SECONDS=300
