# Backline App Server
# Copy to .env.local

# Where the Inference API server lives. Same box during development; change to
# the GPU machine's LAN IP to split the two services across hardware.
INFERENCE_API_URL=http://127.0.0.1:8001

# Rendered backing tracks are copied here on a cache miss.
CACHE_DIR=../cache

# Audio the user drops in gets scanned from here.
SONGS_DIR=./data/songs

PORT=3000
